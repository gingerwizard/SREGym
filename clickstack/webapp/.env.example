# ClickHouse HTTP endpoint and a read-only user with SELECT on the results database. Never commit real values;
# in Vercel these are project environment variables (sensitive), locally they go in .env.local.
CLICKHOUSE_URL=https://your-service.region.gcp.clickhouse.cloud:8443
CLICKHOUSE_USER=clickstack_readonly
CLICKHOUSE_PASSWORD=
# Where clickstack/load_results.py put the results.
CLICKHOUSE_DATABASE=sregym_results
RESULTS_ATTEMPTS_TABLE=attempts
RESULTS_TOOL_CALLS_TABLE=tool_calls
RESULTS_PROBLEM_SETS_TABLE=problem_sets
RESULTS_SCORED_VIEW=attempts_scored
# Shared password for the deployed app: browsers get a one-field login page that sets a signed cookie; tools may send it
# as HTTP Basic auth with any username. Leave empty locally to run without it.
APP_PASSWORD=
